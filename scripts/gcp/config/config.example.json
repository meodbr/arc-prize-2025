{
    "displayName": "<your-job-name>",
    "jobSpec": {
        "workerPoolSpecs": [
            {
                "machineSpec": {
                    "machineType": "n1-highmem-4",
                    "acceleratorType": "NVIDIA_TESLA_T4",
                    "acceleratorCount": 1
                },
                "replicaCount": 1,
                "containerSpec": {
                    "imageUri": "europe-west4-docker.pkg.dev/<project-id>/<repo-gcp-artifact-registry>/<image-name>:<tag>",
                    "args": ["-m", "arc_tartiflette.train"],
                    "env": [
                        {
                            "name": "HUGGING_FACE_TOKEN",
                            "value": "<your-hf-token>"
                        },
                        {
                            "name": "HF_BASE_MODEL",
                            "value": ""
                        },
                        {
                            "name": "HF_OUTPUT_MODEL",
                            "value": ""
                        },
                        {
                            "name": "HF_DATASET",
                            "value": ""
                        },
                        {
                            "name": "HF_USER",
                            "value": ""
                        },
                        {
                            "name": "TRAIN_METHOD",
                            "value": "<transformers|trl>"
                        }
                    ]
                }
            }
        ],
        "scheduling": {
            "strategy": "SPOT"
        }
    }
}